#!/usr/bin/env bash

PIPELINE_ENV_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$PIPELINE_ENV_DIR/../.." && pwd)"

# Root paths and run identity
: "${PROJECT_ROOT:=/hpc/faststorage/miller/fMRI-denoising}"
: "${NSD_RAW_DIR:=/hpc/faststorage/miller/fMRI-denoising/nsd_data}"
: "${EXP_ID:=nsd}"
: "${ARCH_TAG:=swift}"
: "${EVAL_TAG:=final_kpass}"

# Acquisition and preprocessing
: "${PROC_TR:=1.333}"
: "${PROC_WINDOW:=40}"
: "${PROC_STRIDE:=20}"
: "${PROC_SUBJECTS:=subj01 subj02 subj03 subj04 subj05 subj06 subj07 subj08}"
: "${DETREND:=run}"
: "${NSD_PROC_DIR:=${PROJECT_ROOT}/02_processed/${PROC_ID}}"

# ID creation
PROC_BASE_DIR="${PROJECT_ROOT}/02_processed"
LATEST_PROC_FILE="${PROC_BASE_DIR}/.latest_proc_id"

if [[ -z "${PROC_ID:-}" ]]; then
    if [[ "${NEW_PROC:-0}" == "1" || ! -f "$LATEST_PROC_FILE" ]]; then
        PROC_ID="nsd_T${PROC_WINDOW}_S${PROC_STRIDE}_tr1333_det-${DETREND}_$(date +%Y%m%d_%H%M%S)"
    else
        PROC_ID="$(<"$LATEST_PROC_FILE")"
    fi
fi


# Training
: "${TRAIN_SUBJECTS:=subj01 subj02 subj03 subj04 subj05 subj06}"
: "${VAL_SUBJECTS:=subj07}"
: "${TEST_SUBJECTS:=subj08}"
: "${EPOCHS:=100}"
: "${BATCH_SIZE:=1}"
: "${LR:=1.5e-4}"
: "${TIME_FRAMES:=40}"
: "${CROP_SIZE:=}"
: "${PATCH_SIZE:=14}"
: "${EMBED_DIM:=96}"
: "${MASK_RATIO:=0.75}"
: "${N_COMP:=3}"
: "${EROSION_ITERATIONS:=1}"
: "${BAND_LOW:=0.01}"
: "${BAND_HIGH:=0.15}"
: "${TRAIN_REC_LOSS_WEIGHT:=1.0}"
: "${TRAIN_TISSUE_LOSS_WEIGHT:=0.1}"
: "${TRAIN_BAND_LOSS_WEIGHT:=0.1}"
: "${TRAIN_ORTHO_LOSS_WEIGHT:=0.05}"
: "${TRAIN_PRIOR_WARMUP_STEPS:=0}"
: "${TRAIN_PRIOR_WARMUP_EPOCHS:=2}"
: "${TRAIN_MIN_CLEAN_VAR_FRAC:=0.05}"
: "${TRAIN_W_MIN_VAR:=1.0}"
: "${TRAIN_DECODER_SKIPS:=full}"
: "${TRAIN_FREE_NOISE_HEAD:=0}"
: "${TRAIN_SOFT_BANDPASS:=0}"
: "${SEED:=1234}"

# Supporting training controls
: "${NUM_WORKERS:=4}"
: "${GRADIENT_CLIP_VAL:=1.0}"
: "${PRECISION:=16-mixed}"
: "${FULL_RES_CHANNELS:=24}"
: "${WEIGHT_DECAY:=0.05}"
: "${EARLY_STOPPING_PATIENCE:=0}"
: "${USE_WANDB:=1}"
: "${WANDB_PROJECT:=fmri-denoising-nsd}"
: "${WANDB_ENTITY:=}"
: "${WANDB_MODE:=online}"
: "${RESUME_CHECKPOINT:=}"

# Evaluation
: "${EVAL_K:=4}"
: "${EVAL_INFERENCE_MODE:=kpass}"
: "${EVAL_MASK_REPEATS:=1}"
: "${EVAL_MAX_WINDOWS_PER_SUBJECT:=0}"
: "${EVAL_VISUAL_EXAMPLES_PER_SUBJECT:=3}"
: "${EVAL_TEMPORAL_PATCH_SIZE:=3}"
: "${TEMPORAL_MAX_WINDOWS_PER_SUBJECT:=12}"
: "${TEMPORAL_PLOTS_PER_SUBJECT:=3}"

# Derived output paths
: "${RUN_ID:=${EXP_ID}_${ARCH_TAG}_T${TIME_FRAMES}_P${PATCH_SIZE}_E${EMBED_DIM}_w${TRAIN_REC_LOSS_WEIGHT}-${TRAIN_TISSUE_LOSS_WEIGHT}-${TRAIN_BAND_LOSS_WEIGHT}-${TRAIN_ORTHO_LOSS_WEIGHT}_s${SEED}_$(date +%Y%m%d)}"
: "${RUN_DIR:=${PROJECT_ROOT}/03_runs/${RUN_ID}}"
: "${CKPT_DIR:=${RUN_DIR}/checkpoints}"
: "${EVAL_DIR:=${RUN_DIR}/eval/${EVAL_TAG}}"
: "${TEMPORAL_EVAL_DIR:=${EVAL_DIR}/temporal}"
: "${SLURM_LOG_DIR:=${RUN_DIR}/slurm_logs}"
: "${LOG_DIR:=${RUN_DIR}/logs}"
: "${VIS_DIR:=${RUN_DIR}/visualizations}"
: "${CHECKPOINT:=${CKPT_DIR}/best.ckpt}"

export PROJECT_ROOT NSD_RAW_DIR NSD_PROC_DIR PROC_ID PROC_TR PROC_WINDOW PROC_STRIDE LATEST_PROC_FILE
export PROC_SUBJECTS EXP_ID ARCH_TAG RUN_ID RUN_DIR CKPT_DIR EVAL_DIR SLURM_LOG_DIR
export LOG_DIR VIS_DIR EVAL_TAG TEMPORAL_EVAL_DIR
export TRAIN_SUBJECTS VAL_SUBJECTS TEST_SUBJECTS EPOCHS BATCH_SIZE LR TIME_FRAMES
export CROP_SIZE PATCH_SIZE EMBED_DIM MASK_RATIO N_COMP EROSION_ITERATIONS BAND_LOW BAND_HIGH
export DETREND TRAIN_REC_LOSS_WEIGHT TRAIN_TISSUE_LOSS_WEIGHT TRAIN_BAND_LOSS_WEIGHT
export TRAIN_ORTHO_LOSS_WEIGHT TRAIN_PRIOR_WARMUP_STEPS TRAIN_PRIOR_WARMUP_EPOCHS
export TRAIN_MIN_CLEAN_VAR_FRAC TRAIN_W_MIN_VAR TRAIN_DECODER_SKIPS
export TRAIN_FREE_NOISE_HEAD TRAIN_SOFT_BANDPASS SEED NUM_WORKERS GRADIENT_CLIP_VAL
export PRECISION FULL_RES_CHANNELS WEIGHT_DECAY EARLY_STOPPING_PATIENCE WANDB_PROJECT
export USE_WANDB WANDB_ENTITY WANDB_MODE
export RESUME_CHECKPOINT CHECKPOINT EVAL_K EVAL_INFERENCE_MODE EVAL_MASK_REPEATS
export EVAL_MAX_WINDOWS_PER_SUBJECT EVAL_VISUAL_EXAMPLES_PER_SUBJECT
export EVAL_TEMPORAL_PATCH_SIZE TEMPORAL_MAX_WINDOWS_PER_SUBJECT TEMPORAL_PLOTS_PER_SUBJECT
